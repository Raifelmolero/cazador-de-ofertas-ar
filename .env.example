# Variables que usa el bot (bot/cazador_bot.py). En producción viven como
# Secrets del repo, no en un .env: los workflows de GitHub Actions las inyectan.
# Este archivo es la referencia de qué existe y para qué sirve.

# ─── Secretos ─────────────────────────────────────────────────────────────────
# Token del bot de Telegram (@BotFather). Sin esto no publica nada.
TELEGRAM_BOT_TOKEN=
# Publisher ID de afiliados: https://partners.mercadolibre.com.ar
# Si está vacío, los links salen sin tracking y no se cobra comisión.
ML_AFFILIATE_ID=
# Instagram (API with Instagram Login) y Threads. Se renuevan solos los lunes
# vía ig_token_refresh.yml. Si faltan, IG/Threads se saltean sin frenar Telegram.
IG_USER_ID=
IG_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ─── Etiquetas de atribución por canal ────────────────────────────────────────
# Van en matt_word del link (matt_tool es fijo). Tienen que coincidir con las
# etiquetas creadas en el Administrador de etiquetas del panel de afiliados.
ML_WORD_TELEGRAM=telegram
ML_WORD_IG=instagram
ML_WORD_THREADS=threads
ML_WORD_WEB=web

# ─── Flags de prueba y de forzado ─────────────────────────────────────────────
# Imprime en vez de publicar. Ojo: el scraper solo llega a ML desde Actions.
DRY_RUN=0
# Fuerzan una publicación sin importar la hora (también son inputs del workflow).
FORCE_IG_KIT=0
FORCE_THREADS=0
FORCE_REEL=0
# No reescribir frontend/data/productos_rentables.json en esta corrida.
SKIP_SITE_DATA=0
# Publicar en otro canal de Telegram (para probar sin tocar el real).
CHANNEL_OVERRIDE=
# JSON de una oferta armada a mano, para los posts especiales.
DEAL_JSON=

# ─── Entorno ──────────────────────────────────────────────────────────────────
# Binario de ffmpeg para armar el reel. En el runner ya viene en el PATH.
FFMPEG_BIN=ffmpeg
# GITHUB_REPOSITORY lo define Actions solo; se usa para armar las URLs de
# raw.githubusercontent con las que IG/Threads se bajan la media.
